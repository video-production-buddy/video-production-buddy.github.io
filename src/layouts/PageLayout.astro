---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { I18N } from 'astrowind:config';

import { getHeaderData, getFooterData } from '~/navigation';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  language?: string;
}

const { metadata, language = I18N.language } = Astro.props;
const headerData = getHeaderData(language);
const footerData = getFooterData(language);
---

<Layout metadata={metadata} language={language}>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-primary focus:text-primary-foreground focus:p-4"
    >{language === 'zh-CN' ? '跳转到正文' : 'Skip to content'}</a
  >
  <slot name="head" slot="head" />
  {
    /*
    Slot fallbacks are rendered explicitly. With `<slot name="x">fallback</slot>`
    Astro still evaluates the fallback when the page overrides the slot, and
    astro-icon then believes the icons inside it (the RSS icon of the default
    header, for instance) were already emitted, so their SVG sprite symbol
    goes missing on that page.
  */
  }
  <slot name="announcement" />
  {Astro.slots.has('header') ? <slot name="header" /> : <Header {...headerData} isSticky />}
  <main id="main" tabindex="-1" class="flex-1">
    <slot />
  </main>
  {Astro.slots.has('footer') ? <slot name="footer" /> : <Footer {...footerData} />}
</Layout>
